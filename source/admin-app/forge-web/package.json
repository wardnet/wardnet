{
  "name": "@wardnet/forge-web",
  "version": "0.1.0",
  "description": "Wardnet Forge — web implementation (Radix-backed primitives applying Forge classes)",
  "private": true,
  "type": "module",
  "exports": {
    "./button": {
      "import": "./src/primitives/button.tsx",
      "types": "./src/primitives/button.tsx"
    },
    "./card": {
      "import": "./src/primitives/card.tsx",
      "types": "./src/primitives/card.tsx"
    },
    "./pill": {
      "import": "./src/primitives/pill.tsx",
      "types": "./src/primitives/pill.tsx"
    },
    "./toggle": {
      "import": "./src/primitives/toggle.tsx",
      "types": "./src/primitives/toggle.tsx"
    },
    "./modal": {
      "import": "./src/primitives/modal.tsx",
      "types": "./src/primitives/modal.tsx"
    },
    "./alert-modal": {
      "import": "./src/primitives/alert-modal.tsx",
      "types": "./src/primitives/alert-modal.tsx"
    },
    "./popover": {
      "import": "./src/primitives/popover.tsx",
      "types": "./src/primitives/popover.tsx"
    },
    "./dropdown-menu": {
      "import": "./src/primitives/dropdown-menu.tsx",
      "types": "./src/primitives/dropdown-menu.tsx"
    },
    "./select": {
      "import": "./src/primitives/select.tsx",
      "types": "./src/primitives/select.tsx"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@wardnet/forge": "portal:../../forge",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "prettier": "3.8.3"
  },
  "packageManager": "yarn@4.13.0"
}
