{
  "name": "@wardnet/site",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "yarn copy:install-script && yarn copy:scalar && yarn generate:sdk-reference && vite",
    "build": "yarn generate:release-manifests && yarn copy:install-script && yarn copy:scalar && yarn generate:sdk-reference && tsc -b && vite build && cp dist/index.html dist/404.html && yarn generate:blog-prerender",
    "preview": "vite preview",
    "type-check": "yarn generate:release-manifests && tsc -b",
    "test": "yarn generate:release-manifests && vitest run",
    "test:watch": "yarn generate:release-manifests && vitest",
    "test:coverage": "yarn generate:release-manifests && vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "generate:release-manifests": "tsx scripts/generate-release-manifests.ts",
    "generate:blog-prerender": "tsx scripts/generate-blog-prerender.ts",
    "generate:sdk-reference": "typedoc --entryPoints ../sdk/wardnet-js/src/index.ts --tsconfig ../sdk/wardnet-js/tsconfig.json --out public/sdk-docs --disableSources --name @wardnet/js --hideGenerator",
    "copy:install-script": "mkdir -p public && cp ../../deploy/install.sh public/install.sh",
    "copy:scalar": "mkdir -p public/api-docs && cp ../daemon/crates/wardnetd-api/assets/vendor/scalar-api-reference.js public/api-docs/scalar.js"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@wardnet/brand": "^0.1.0",
    "@wardnet/styles": "^0.1.0",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-router": "8.2.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modyfi/vite-plugin-yaml": "1.1.1",
    "@octokit/rest": "22.0.1",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-security": "4.0.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.4",
    "semver": "7.8.5",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  },
  "packageManager": "yarn@4.17.0"
}
