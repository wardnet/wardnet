{
  "name": "@wardnet/styles",
  "version": "0.1.0",
  "description": "Wardnet web design language — CSS tokens, themes, and component classes",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./styles.css",
    "./styles.css": "./styles.css",
    "./tokens": {
      "import": "./src/tokens.ts",
      "types": "./src/tokens.ts"
    }
  },
  "files": [
    "src",
    "styles.css"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.13.0"
}
