{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // tsup's dts bundler (rollup-plugin-dts) unconditionally injects a
    // `baseUrl` compiler option for its internal Program even though we
    // don't set one ourselves — TS 6 treats that as a deprecated-error
    // otherwise.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}
