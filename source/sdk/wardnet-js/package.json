{
  "name": "@wardnet/js",
  "version": "0.4.0",
  "description": "TypeScript SDK for the Wardnet network privacy gateway",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "devDependencies": {
    "prettier": "3.9.4",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "consola": "^3.4.2"
  }
}
