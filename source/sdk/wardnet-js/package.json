{
  "name": "@wardnet/js",
  "version": "0.6.0",
  "description": "TypeScript SDK for the Wardnet network privacy gateway",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wardnet/wardnet.git",
    "directory": "source/sdk/wardnet-js"
  },
  "homepage": "https://github.com/wardnet/wardnet/tree/main/source/sdk/wardnet-js#readme",
  "bugs": {
    "url": "https://github.com/wardnet/wardnet/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./consola": {
      "types": "./dist/consola.d.ts",
      "import": "./dist/consola.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "generate": "node scripts/generate-openapi.mjs",
    "generate:check": "node scripts/generate-openapi.mjs && git diff --exit-code -- src/internal/openapi-schema.ts",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "consola": "^3.4.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "consola": "^3.4.2"
  },
  "peerDependenciesMeta": {
    "consola": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.17.0"
}
