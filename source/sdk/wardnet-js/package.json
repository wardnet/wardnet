{
  "name": "@wardnet/js",
  "version": "0.5.0",
  "description": "TypeScript SDK for the Wardnet network privacy gateway",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./consola": {
      "types": "./dist/consola.d.ts",
      "import": "./dist/consola.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "consola": "^3.4.2",
    "prettier": "3.9.4",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "consola": "^3.4.2"
  },
  "peerDependenciesMeta": {
    "consola": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.17.0"
}
