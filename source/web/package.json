{
  "name": "@wardnet/web",
  "version": "0.1.0",
  "description": "Shared React feature components, hooks, and SDK wiring for Wardnet web apps (composes @wardnet/ui)",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@wardnet/ui": "^0.3.0",
    "clsx": "2.1.1",
    "cronstrue": "3.21.0",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "@wardnet/js": "*",
    "lucide-react": ">=1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.0",
    "vitest": "4.1.8"
  },
  "packageManager": "yarn@4.17.0"
}
