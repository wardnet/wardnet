# syntax=docker/dockerfile:1
#
# wardnetd test image — adds the wardnet-test-agent binary on top of a
# self-contained wardnetd install. End-to-end tests query the agent
# over HTTP and inspect the same kernel state the daemon manipulates.
#
# Self-contained build: this image does NOT pull a signed release from
# GitHub. It compiles wardnetd + the test-agent from local sources,
# packages wardnetd into the same release-tarball layout install.sh
# consumes, signs it with an ephemeral minisign key generated during
# the build, and runs the unmodified install.sh against that bundle.
# That way the test image exercises the real install path end-to-end
# (binary placement, user/group setup, systemd unit drop, signature
# verification) while still being buildable from a PR branch where no
# release tag exists.
#
# Build context: repo root
#   docker build -f source/daemon/Dockerfile.test -t wardnetd:dev-test .
#   make image-test            (placeholder web assets — API/kernel suite)
#   docker build --build-arg WEB_DIST=real …   (real web assets — UI suite)

# ---- Web asset stages (selected by the WEB_DIST build arg) ----
# wardnetd embeds three frontend dist/ trees via rust-embed at compile
# time (crates/wardnetd-api/src/web.rs). The API/kernel e2e suite never
# renders the UI, so the default `placeholder` path bakes empty
# index.html files and keeps this image independent of `make build-web`.
# The Playwright UI suite (source/end2end-tests/web-ui) builds with
# `--build-arg WEB_DIST=real` to embed the real dist/ trees — run
# `make build-web` first to populate them in the context. BuildKit only
# builds the stage the `web` alias selects, so the default placeholder
# build never reads the real dist/ paths and works on a bare checkout.
ARG WEB_DIST=placeholder

FROM busybox:1.38@sha256:dc2d74b28e4cf8984fa52af1f39bc7c3d9c73760b41a74d629f5d11b1ab28616 AS web-placeholder
RUN mkdir -p \
        /web/admin-site/dist \
        /web/user-app/dist \
        /web/admin-app/dist \
        /web/admin-site/src/assets \
    && printf '<!doctype html><html><head></head><body></body></html>\n' \
        | tee /web/admin-site/dist/index.html \
              /web/user-app/dist/index.html \
              /web/admin-app/dist/index.html > /dev/null \
    && printf 'placeholder\n' > /web/admin-site/src/assets/logo.png

# Real built frontends, copied from the context (populated by
# `make build-web`). Only built when WEB_DIST=real, so the default build
# never reads these paths — and a bare checkout without dist/ still
# builds the placeholder image.
FROM scratch AS web-real
COPY source/admin-site/dist /web/admin-site/dist
COPY source/user-app/dist /web/user-app/dist
COPY source/admin-app/dist /web/admin-app/dist
COPY source/admin-site/src/assets /web/admin-site/src/assets

FROM web-${WEB_DIST} AS web

# ---- Builder stage: compile wardnetd + wardnet-test-agent ----
# Pinned by digest for supply-chain integrity. Matches the workspace
# rust-version in source/daemon/rust-toolchain.toml.
# The toolchain layer every Rust stage below shares, so the apt install and the
# cargo-chef install are paid once and cached rather than repeated per stage.
FROM rust:1.97-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS chef

# minisign is needed at build time to generate the ephemeral signing
# key + sign the synthetic release tarball that install.sh consumes.
#
# clang + libclang-dev: rustables' build.rs runs bindgen against
# <linux/netfilter/nf_tables.h> (issue #307). linux-libc-dev supplies
# those kernel uapi headers — unlike the full rust:1.96 image the
# Makefile container path uses, the slim image here ships neither the
# headers nor libclang, so both must be added explicitly.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        minisign \
        clang \
        libclang-dev \
        linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*

# cargo-chef splits dependency compilation from workspace compilation. Without
# it a single layer carries both, so any change under source/daemon/ rebuilds
# ~500 dependencies from scratch — most of the 21 minutes this image took, on
# exactly the changes that trigger it.
# Version-pinned, and not below 0.1.77: the workspace Cargo.toml sets
# `resolver = "3"`, which every cargo-chef before 0.1.69 rejects outright
# ("unknown variant `3`, expected `1` or `2`") because it bundles a
# pre-Rust-2024 TOML parser.
RUN cargo install cargo-chef --locked --version 0.1.77

WORKDIR /build

# Reduces the workspace to its manifests. recipe.json changes only when a
# Cargo.toml or Cargo.lock does, which is what lets the cook layer below
# survive an ordinary source change.
FROM chef AS planner
COPY source/daemon/ /build/
RUN cargo chef prepare --recipe-path /recipe.json

FROM chef AS builder

# cook compiles the workspace skeleton, so each crate's build.rs still runs:
# build-support/version.rs reads ../../../../CALVER and wardnetd-services
# include_str!s deploy/keys/wardnet-release.pub. Both must exist before
# dependency compilation, and both are near-static, so putting them ahead of
# the cook layer costs no cache hits.
COPY CALVER /CALVER
COPY deploy/ /deploy/

COPY --from=planner /recipe.json /recipe.json
RUN cargo chef cook --release --recipe-path /recipe.json

# The real sources, replacing the skeleton cook left behind. This is the first
# layer an ordinary daemon change invalidates, so everything above it — the
# toolchain, the apt packages and the ~500 compiled dependencies — survives.
COPY source/daemon/ /build/
# web.rs embeds three asset trees via rust-embed; paths resolve from the
# crate manifest dir (/build/crates/wardnetd-api/) three ../ steps up,
# landing at the filesystem root — so the trees go to /admin-site/dist,
# /user-app/dist, /admin-app/dist, and admin-site's include'd logo asset
# at /admin-site/src/assets. Pulled from the `web` stage, which is the
# placeholder or the real build per the WEB_DIST arg.
COPY --from=web /web/admin-site/dist /admin-site/dist
COPY --from=web /web/user-app/dist /user-app/dist
COPY --from=web /web/admin-app/dist /admin-app/dist
COPY --from=web /web/admin-site/src/assets /admin-site/src/assets

# Default to a synthetic dev version when no release tag exists.
# install.sh extracts the version from the tarball filename, so any
# value that round-trips through `wardnetd-<version>-<arch>.tar.gz`
# works.
ARG WARDNET_VERSION=0.0.0-dev

# Version advertised by the e2e release fixture and compiled into the
# *second* wardnetd build below (issue #319). Must match the `version`
# field in
# source/end2end-tests/daemon/fixtures/update-manifests/beta.json —
# the daemon derives the asset filename as
# `wardnetd-<manifest version>-<arch>.tar.gz`, so a mismatch surfaces
# as a 404 during the download phase rather than as a clear error.
#
# Chosen to outrank anything this repo will ever build, so
# `is_newer(fixture, current)` holds regardless of the version the
# first build resolved.
ARG E2E_RELEASE_VERSION=9999.12.31

# Generate the ephemeral signing keypair BEFORE compiling so the
# wardnet-postupgrade-runner build embeds the test pubkey via
# WARDNET_POSTUPGRADE_PUBKEY_PATH. -W = no password (prompt-free);
# -f = overwrite if a key file already exists. Kept under /tmp so
# the private key never lands in a runtime layer.
#
# The second keypair exists purely to produce a *validly-formatted but
# wrong-key* signature for the auto-update trust-anchor spec (#319).
# Its public half is never embedded anywhere, so anything it signs is
# rejected by both the daemon and the post-upgrade runner — which is
# the whole point.
RUN mkdir -p /tmp/local-bundle /tmp/wrong-key \
    && minisign -G -W -f \
        -p /tmp/local-bundle/local-bundle.pub \
        -s /tmp/local-bundle/local-bundle.key \
    && minisign -G -W -f \
        -p /tmp/wrong-key/wrong-key.pub \
        -s /tmp/wrong-key/wrong-key.key

# Build wardnetd + the test agent + the post-upgrade pipeline binaries.
# WARDNET_POSTUPGRADE_PUBKEY_PATH points at the ephemeral pubkey so the
# runner's trust anchor in this image only honours signatures from the
# same ephemeral keypair (production builds default to
# deploy/keys/wardnet-release.pub).
#
# WARDNET_RELEASE_PUBKEY_PATH does the same for the *daemon* side
# (crates/wardnetd-services/build.rs → update/mod.rs
# EMBEDDED_PUBLIC_KEY). Both must point at the same key: the daemon
# verifies the release tarball before staging it and the runner
# re-verifies the same bytes under root, so a split would either break
# ordinary boots or wedge every auto-update. Setting it here is what
# lets the e2e suite keep `[update] require_signature = true` and still
# install a locally-signed release. See
# docs/adr/0027-e2e-auto-update-version-skew.md.
RUN WARDNET_POSTUPGRADE_PUBKEY_PATH=/tmp/local-bundle/local-bundle.pub \
    WARDNET_RELEASE_PUBKEY_PATH=/tmp/local-bundle/local-bundle.pub \
    cargo build --release \
        -p wardnetd \
        -p wardnet-test-agent \
        -p wardnet-postupgrade-runner \
        -p wardnet-postupgrade \
    && strip \
        target/release/wardnetd \
        target/release/wardnet-test-agent \
        target/release/wardnet-postupgrade-runner \
        target/release/wardnet-postupgrade

# Build the synthetic release bundle that install.sh --from consumes:
# tarball + sha256 + minisig + the systemd units. After signing the
# inner postupgrade binary, the private half of the keypair is
# dropped — only the public key leaves this stage so the runtime
# stage can patch it into install.sh's embedded MINISIGN_PUBLIC_KEY.
RUN <<"EOF" bash
set -euo pipefail
case "$(uname -m)" in
    aarch64|arm64) ARCH=aarch64 ;;
    x86_64|amd64)  ARCH=x86_64 ;;
    *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;;
esac
TARBALL="wardnetd-${WARDNET_VERSION}-${ARCH}.tar.gz"

# Stage the tarball contents. The post-upgrade payload binary is
# renamed to `wardnet-postupgrade.bin` (the runtime trust anchor's
# expected filename) and signed with the ephemeral key — same trust
# model as production, just keyed by an in-image keypair.
STAGE=$(mktemp -d)
cp target/release/wardnetd                    "$STAGE/wardnetd"
cp target/release/wardnet-postupgrade-runner  "$STAGE/wardnet-postupgrade-runner"
cp target/release/wardnet-postupgrade         "$STAGE/wardnet-postupgrade.bin"
cp /deploy/wardnet-postupgrade.service        "$STAGE/wardnet-postupgrade.service"
minisign -S -W \
    -s /tmp/local-bundle/local-bundle.key \
    -t "wardnet-test-image postupgrade" \
    -m "$STAGE/wardnet-postupgrade.bin" \
    -x "$STAGE/wardnet-postupgrade.minisig"
tar -C "$STAGE" -czf "/tmp/local-bundle/${TARBALL}" \
    wardnetd \
    wardnet-postupgrade-runner \
    wardnet-postupgrade.bin \
    wardnet-postupgrade.minisig \
    wardnet-postupgrade.service

# Keep the post-upgrade payload + its signature (and the runner and
# unit file) so the e2e release bundle built below can reuse the exact
# same bytes rather than re-deriving them (issue #319).
#
# Byte-identity matters: `FsBinaryApplier::stage_pending` swaps the
# payload pair into /var/lib/wardnet/postupgrade/ on every install, but
# the runner's `perform_rollback` restores only the wardnetd binary. If
# the two bundles carried different payload bytes, a rollback would
# leave the container in a state the swap spec didn't start from, and
# every later spec would inherit it.
mkdir -p /tmp/postupgrade-artifacts
cp "$STAGE/wardnet-postupgrade.bin"     /tmp/postupgrade-artifacts/
cp "$STAGE/wardnet-postupgrade.minisig" /tmp/postupgrade-artifacts/
cp "$STAGE/wardnet-postupgrade-runner"  /tmp/postupgrade-artifacts/
cp "$STAGE/wardnet-postupgrade.service" /tmp/postupgrade-artifacts/

rm -rf "$STAGE"

# SHA-256 sidecar. install.sh reads the hash with `awk '{print $1}'`,
# so the standard `sha256sum` two-column format works as-is.
( cd /tmp/local-bundle && sha256sum "${TARBALL}" > "${TARBALL}.sha256" )

# Sign the outer tarball with the same ephemeral key. -t pins the
# trusted comment so install.sh's verification produces stable
# output across rebuilds.
minisign -S -W \
    -s /tmp/local-bundle/local-bundle.key \
    -t "wardnet-test-image local build" \
    -m "/tmp/local-bundle/${TARBALL}"

# Bundle the systemd units alongside the tarball — install.sh's
# --from path looks them up next to the archive (in addition to
# whatever's inside the tarball, which it doesn't read here).
cp /deploy/wardnetd.service \
   /deploy/wardnetd-rollback.service \
   /deploy/wardnet-postupgrade.service \
   /tmp/local-bundle/

EOF

# ---- Second wardnetd build: the release the e2e suite installs ----
#
# Issue #319 needs a version transition, and the daemon compares the
# manifest's version against its own compile-time `version::VERSION`
# (wardnetd-services/src/version.rs, fed by WARDNET_VERSION). A tarball
# carrying the *same* binary the container is already running would be
# staged, swapped, and then reported by
# `do_reconcile_pending_install` as "binary swap reverted" — the daemon
# would come back as the old version and record a failed history row.
# So the served release genuinely has to be a distinct build.
#
# It cannot instead be a real previous release pulled from GitHub: both
# trust anchors (the daemon's EMBEDDED_PUBLIC_KEY and the runner's
# embedded key) are baked in at compile time, so a genuinely-released
# binary only ever trusts the real release key — which we cannot sign
# with. Synthesising the skew from this one source tree is the only
# workable shape. See docs/adr/0027-e2e-auto-update-version-skew.md.
#
# Only `-p wardnetd` is rebuilt; the version override invalidates
# wardnetd-services and its dependents, and everything else stays warm
# in the cargo cache.
RUN cp target/release/wardnetd /tmp/wardnetd-live \
    && WARDNET_POSTUPGRADE_PUBKEY_PATH=/tmp/local-bundle/local-bundle.pub \
       WARDNET_RELEASE_PUBKEY_PATH=/tmp/local-bundle/local-bundle.pub \
       WARDNET_VERSION_OVERRIDE=${E2E_RELEASE_VERSION} \
       cargo build --release -p wardnetd \
    && strip target/release/wardnetd \
    && mv target/release/wardnetd /tmp/wardnetd-next \
    && mv /tmp/wardnetd-live target/release/wardnetd \
    && /tmp/wardnetd-next --version | grep -q "${E2E_RELEASE_VERSION}"

# Guard above, not decoration: if cargo ever failed to notice the
# version override (a dropped `rerun-if-env-changed`, a fingerprint
# quirk) the second build would silently be a byte-identical copy of
# the first. The e2e suite would then install a tarball carrying the
# version it is already running, the daemon would report
# `binary swap reverted`, and the failure would look like a broken swap
# rather than a broken image build. Failing the build here keeps that
# diagnosis cheap.

# Assemble the release bundle the fake release server publishes:
# tarball + sha256 sidecar + minisig, in the exact layout
# `HttpsManifestSource` derives from the manifest
# (`<asset_base_url>/wardnetd-<version>-<arch>.tar.gz` plus `.sha256`
# and `.minisig` siblings).
#
# A second, wrong-key signature is emitted alongside for the
# trust-anchor spec. It is NOT served — the test agent stages it
# directly into /var/lib/wardnet/updates/ to prove the runner refuses
# to swap bytes it cannot verify, which is the one path the daemon's
# own pre-stage verify would otherwise shield.
RUN <<"EOF" bash
set -euo pipefail
case "$(uname -m)" in
    aarch64|arm64) ARCH=aarch64 ;;
    x86_64|amd64)  ARCH=x86_64 ;;
    *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;;
esac
TARBALL="wardnetd-${E2E_RELEASE_VERSION}-${ARCH}.tar.gz"

mkdir -p /tmp/release-bundle /tmp/e2e-artifacts

STAGE=$(mktemp -d)
cp /tmp/wardnetd-next                                     "$STAGE/wardnetd"
cp /tmp/postupgrade-artifacts/wardnet-postupgrade-runner  "$STAGE/"
cp /tmp/postupgrade-artifacts/wardnet-postupgrade.bin     "$STAGE/"
cp /tmp/postupgrade-artifacts/wardnet-postupgrade.minisig "$STAGE/"
cp /tmp/postupgrade-artifacts/wardnet-postupgrade.service "$STAGE/"
tar -C "$STAGE" -czf "/tmp/release-bundle/${TARBALL}" \
    wardnetd \
    wardnet-postupgrade-runner \
    wardnet-postupgrade.bin \
    wardnet-postupgrade.minisig \
    wardnet-postupgrade.service
rm -rf "$STAGE"

( cd /tmp/release-bundle && sha256sum "${TARBALL}" > "${TARBALL}.sha256" )

minisign -S -W \
    -s /tmp/local-bundle/local-bundle.key \
    -t "wardnet-test-image e2e release" \
    -m "/tmp/release-bundle/${TARBALL}"

# The corrupt pair for the trust-anchor spec: the same good tarball,
# signed by a key nothing trusts. Named for the paths the test agent
# stages them to, so the handler needs no arch or version awareness.
cp "/tmp/release-bundle/${TARBALL}" /tmp/e2e-artifacts/wardnetd-pending.tar.gz
minisign -S -W \
    -s /tmp/wrong-key/wrong-key.key \
    -t "wardnet-test-image WRONG KEY - must be rejected" \
    -m /tmp/e2e-artifacts/wardnetd-pending.tar.gz \
    -x /tmp/e2e-artifacts/wardnetd-pending.tar.gz.badsig

# Drop both private keys. The local-bundle public key stays so the
# runtime stage can patch install.sh's embedded MINISIGN_PUBLIC_KEY
# before invoking the script.
rm -rf /tmp/wrong-key
rm -f /tmp/local-bundle/local-bundle.key
EOF

# ---- Release-server stage: static assets for the e2e fake release ----
# Selected by source/end2end-tests/daemon/compose.yaml via
# `target: release-server`. Sharing this Dockerfile (rather than a
# standalone one under end2end-tests/) means BuildKit reuses the
# builder stage already materialised for the daemon image instead of
# compiling wardnetd a third time.
FROM busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662 AS release-server
COPY --from=builder /tmp/release-bundle /srv

# ---- Runtime stage: layer onto wardnet-base + run install.sh ----
# wardnet-base provides debian:bookworm-slim + apt: systemd,
# systemd-sysv, iproute2, nftables, wireguard-tools, ca-certificates,
# wget, curl, minisign + the systemd unit cleanup + the wardnetd
# container drop-in + EXPOSE 53/53/67/7411 + STOPSIGNAL +
# CMD ["/lib/systemd/systemd"]. Pinned by the multi-arch index digest
# so the per-arch manifest is selected at pull time.
# Source: ghcr.io/wardnet/wardnet-base:bookworm-1
FROM ghcr.io/wardnet/wardnet-base@sha256:ba478f4a8b6441af3ebe8b3b4918d44040905a4b92dcefaf0d150eede8aad53b

# Test-only client tooling: dig (DNS probe), ping (reachability),
# dhclient (lease renew). policykit-1 ships pkcheck + the polkitd
# daemon, both required for the Safe Reboot / Safe Shutdown
# end-to-end spec (#215). Not in wardnet-base because the prod image
# doesn't need them; they only exist for the wardnet-test-agent
# client subcommands that the end-to-end suite drives.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        dnsutils \
        iputils-ping \
        isc-dhcp-client \
        policykit-1 \
    && rm -rf /var/lib/apt/lists/*

# install.sh + service units copied from the repo (online manifest
# fetch is not used; --from overrides it). The bundle from the
# builder stage carries the tarball + signatures.
COPY deploy/ /tmp/wardnet-deploy/
COPY --from=builder /tmp/local-bundle /tmp/local-bundle/

# Corrupt-pair fixtures for the auto-update trust-anchor spec (#319).
# A known-good release tarball plus a signature over it made with a key
# no binary in this image embeds. `wardnet-test-agent`'s
# POST /update/stage-bad-signature copies these into
# /var/lib/wardnet/updates/ so the post-upgrade runner sees bytes the
# wardnet user could plausibly have staged, and refuses to swap them.
#
# Parked outside /tmp so the scrub below (and any tmpfs mount at
# runtime) leaves them alone.
COPY --from=builder /tmp/e2e-artifacts /usr/local/share/wardnet-e2e/

# Run install.sh against the local bundle. Two pre-steps:
#   1. Patch the embedded MINISIGN_PUBLIC_KEY with the ephemeral
#      pubkey so signature verification accepts the locally-signed
#      tarball. The pub file from `minisign -G` is the same two-line
#      format install.sh expects (untrusted-comment + base64 body).
#   2. LAN_INTERFACE=eth0 short-circuits the interactive prompt; the
#      value is irrelevant inside the test container (the daemon's
#      LAN attach is reconfigured by the e2e compose), but install.sh
#      requires *something*.
#
# After the install, scrub the bundle + deploy dir + apt-purge
# build-only deps. minisign stays purged even though the e2e suite now
# does drive auto-update (#319): every signature check on the install
# path runs through the `minisign_verify` crate compiled into wardnetd
# and the post-upgrade runner, never the CLI. install.sh is the only
# consumer of the binary and it has already run by this point.
RUN <<"EOF" bash
set -euo pipefail
awk -v pub="$(cat /tmp/local-bundle/local-bundle.pub)" '
    /^MINISIGN_PUBLIC_KEY='\''/ { print "MINISIGN_PUBLIC_KEY='\''" pub "'\''"; skip=1; next }
    skip && /'\''[[:space:]]*$/ { skip=0; next }
    skip { next }
    { print }
' /tmp/wardnet-deploy/install.sh > /tmp/install.sh.new
mv /tmp/install.sh.new /tmp/wardnet-deploy/install.sh
chmod +x /tmp/wardnet-deploy/install.sh

LAN_INTERFACE=eth0 bash /tmp/wardnet-deploy/install.sh \
    --from /tmp/local-bundle \
    --container-mode

apt-get purge -y minisign
apt-get autoremove -y
rm -rf /tmp/local-bundle /tmp/wardnet-deploy /var/lib/apt/lists/*
EOF

# Drop in the test-agent binary + systemd unit. The unit is enabled
# via a manual symlink because systemctl is not running during the
# image build; systemd will start the service when it initialises as
# PID 1 at container runtime, alongside wardnetd.service.
COPY --from=builder /build/target/release/wardnet-test-agent /usr/local/bin/wardnet-test-agent
COPY source/daemon/packaging/test-agent/wardnet-test-agent.service \
    /etc/systemd/system/wardnet-test-agent.service

RUN chmod 0755 /usr/local/bin/wardnet-test-agent \
    && chmod 0644 /etc/systemd/system/wardnet-test-agent.service \
    && ln -s /etc/systemd/system/wardnet-test-agent.service \
        /etc/systemd/system/multi-user.target.wants/wardnet-test-agent.service

# Shim for `systemctl` at /usr/sbin/systemctl that intercepts the
# `reboot` / `poweroff` subcommands so the Safe Reboot / Safe
# Shutdown end-to-end spec (#215) can assert the daemon's spawned
# task actually invoked them — without literally rebooting CI.
#
# The daemon's production `ShellCommandExecutor` resolves the
# program name through `/usr/sbin` and `/sbin` first (see
# `source/daemon/crates/wardnetd/src/command.rs`), so a binary
# named `systemctl` parked here is what wardnetd will exec when
# `SystemctlPowerOps::reboot()` / `.poweroff()` runs. Other
# systemctl callers (the test agent, install.sh, manual `docker
# exec` debugging) keep using the real binary at `/usr/bin/systemctl`
# — this shim only shadows for processes that resolve via sbin.
#
# The shim writes its argv to a marker file under /var/lib/wardnet
# that the test-agent's `/power/systemctl-invocations` endpoint
# surfaces back to the spec. Each invocation appends a line; the
# spec reads the whole file and asserts the expected verbs landed.
COPY <<"SHIM_EOF" /usr/sbin/systemctl
#!/bin/sh
# Test-only shim — see Dockerfile.test for context. Installed by
# the wardnet test image so end-to-end specs can verify Safe
# Reboot / Safe Shutdown without rebooting CI.
mkdir -p /var/lib/wardnet
echo "$@" >> /var/lib/wardnet/systemctl-invocations.log
exit 0
SHIM_EOF
RUN chown root:root /usr/sbin/systemctl \
    && chmod 0755 /usr/sbin/systemctl

# wardnet-base already exposes 53/udp 53/tcp 67/udp 7411/tcp for the
# daemon; the test-agent's HTTP probe API listens on 3001 (see
# source/daemon/packaging/test-agent/wardnet-test-agent.service).
EXPOSE 3001/tcp
