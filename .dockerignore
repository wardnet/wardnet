# Exclude large Rust build artifact trees — not needed in the Dockerfile.test
# build context and would make context transfer very slow.
source/daemon/target/
source/bridge/target/

# Yarn/npm caches and install state — not needed and can be large.
**/node_modules/
**/.yarn/cache/
**/.yarn/install-state.gz

# Packages not referenced by Dockerfile.test at all.
source/marketing-site/
source/end2end-tests/

# Git and CI metadata.
.git/
.github/

# Editor / dev tool noise.
.agents/
.claude/
.vscode/
.idea/
brand/
docs/
