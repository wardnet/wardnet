[Unit]
Description=Wardnet Daemon
After=network-online.target
Wants=network-online.target
# If the daemon crash-loops after an auto-update, the on-failure unit
# rolls the binary back to <live>.old. `OnFailure=` fires when the unit
# enters `failed` state, which the StartLimit* knobs below guarantee
# after 3 crashes within 120s.
OnFailure=wardnetd-rollback.service

[Service]
# Type=notify: the daemon sends sd_notify(READY=1) once all listeners are
# bound, so systemd only marks the unit active(running) when it can actually
# serve. This also arms the watchdog supervision below (issue #214).
Type=notify
# Only the main process (wardnetd itself) is allowed to send notifications —
# READY=1 and the periodic WATCHDOG=1 pings both originate there.
NotifyAccess=main
User=wardnet
Group=wardnet
ExecStart=/usr/local/bin/wardnetd --config /etc/wardnet/wardnet.toml
Restart=always
RestartSec=2s
# Auto-update crash-loop budget. If the daemon fails to stay up for 3
# restarts within 120s, systemd marks the unit as failed and the
# OnFailure= rollback unit kicks in. `StartLimitAction=none` avoids
# systemd's default aggressive stop once the budget is exhausted — we
# let the rollback unit swap the binary back, then manual recovery
# (or the next update check) takes over.
StartLimitIntervalSec=120
StartLimitBurst=3
StartLimitAction=none

# Capabilities — CAP_NET_ADMIN covers nftables/route netlink and child tools (ip, sysctl)
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

# /run/wardnetd is created by systemd at service start, owned by
# User=wardnet, mode 0755, and removed on clean stop. Without this
# the unprivileged wardnet user can't write its pidfile to /run
# (root:root tmpfs) and `kill -TERM $(cat …)` plus the test-agent's
# /pid endpoint silently break.
RuntimeDirectory=wardnetd
RuntimeDirectoryMode=0755

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# Auto-update stages the new tarball into /var/lib/wardnet/updates/;
# the privileged `wardnet-postupgrade.service` performs the actual
# /usr/local/bin/wardnetd swap on next start under root, so the
# wardnet user no longer needs write access to /usr/local/bin.
ReadWritePaths=/var/lib/wardnet /var/log/wardnet
PrivateTmp=yes

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wardnetd

# Soft watchdog (issue #214): the daemon sends sd_notify(WATCHDOG=1) only while
# its HealthMonitor reports overall UP and the snapshot is fresh. If health goes
# DOWN — or the health loop itself stalls — the daemon withholds the ping, this
# 15s budget elapses, and systemd restarts the *service* (seconds; the host
# stays up). This is the proportionate middle layer; a *total* runtime freeze
# (even the health loop wedged) is caught instead by the ungated hardware
# /dev/watchdog, which reboots the host.
#
# WatchdogSec interacts with the StartLimit* budget above: repeated watchdog
# restarts count toward StartLimitBurst, so a persistently-unhealthy daemon
# eventually trips OnFailure=wardnetd-rollback.service (post-update crash-loop
# recovery) rather than restarting forever.
WatchdogSec=15

[Install]
WantedBy=multi-user.target
