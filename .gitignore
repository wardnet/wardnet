source/daemon/target/
# The fuzz dir is its own cargo workspace (excluded from the daemon
# workspace), so it gets its own target dir.
source/daemon/fuzz/target/
node_modules/
# Web app build output is regenerated by `make build-web` (and embedded into
# the daemon via rust-embed at compile time), so it is never sourced from git.
# Only the tracked `.info` sentinel keeps each directory present, because
# rust-embed's `#[folder = ".../dist"]` requires the directory to exist for the
# daemon crate to compile (local builds / clippy / IDE) before any web build has
# run. See each dist/.info for details.
source/admin-site/dist/*
!source/admin-site/dist/.info
source/user-app/dist/*
!source/user-app/dist/.info
source/admin-app/dist/*
!source/admin-app/dist/.info
source/marketing-site/dist/

# Vitest coverage + JUnit output for every JS workspace (including nested
# ones such as source/sdk/wardnet-js).
source/**/coverage/
source/**/test-results/
# Repo-root coverage artefacts. `make coverage-daemon` writes the daemon's
# LCOV/JSON here (CI reads them from this path), and local cargo-llvm-cov
# runs land alongside — all generated. Note `coverage/daemon-lcov.info` is
# already tracked (committed in 01434e9a), so this rule only keeps *new*
# artefacts out; untracking that one is a separate cleanup.
/coverage/
# `go test -coverprofile` output. Written inside the module it measures —
# that is where bulwark's per-module lookup expects it — so it lands in the
# working tree of whoever runs the Go coverage job locally.
source/**/coverage.out
# Generated by `yarn generate:release-manifests` at build time.
source/marketing-site/src/generated/
source/marketing-site/public/releases/
# Per-version OpenAPI specs downloaded by the same generator at build time.
source/marketing-site/public/api-specs/
# Copied from deploy/install.sh at build time by `yarn copy:install-script`.
source/marketing-site/public/install.sh
# Vendored Scalar bundle copied from the daemon at build time by `yarn copy:scalar`.
source/marketing-site/public/api-docs/
# TypeDoc HTML reference generated from source/sdk/wardnet-js at build time by
# `yarn generate:sdk-reference`.
source/marketing-site/public/sdk-docs/
**/.yarn/install-state.gz
**/.yarn/cache/
**/.yarn/unplugged/
**/.pnp.cjs
**/.pnp.loader.mjs
# Built design-system / web library output (regenerated by `turbo run build`).
source/ui/dist/
source/web/dist/
# Built @wardnet/js output, published to npmjs.org (regenerated by
# `yarn build`/`make build-sdk`).
source/sdk/wardnet-js/dist/
# Storybook static export.
**/storybook-static/
*.db
*.db-shm
*.db-wal
*.key
.env
.DS_Store
.vscode/
.idea/
# Agentic-toolkit generated outputs — synced from .agents/ (+ the extended
# stacks) on every toolkit sync. The sources are committed; these regenerate,
# so they are never committed. Anchored to the repo root so intentionally
# tracked CLAUDE.md/AGENTS.md files in subdirectories are unaffected.
/.claude/
/CLAUDE.md
/.mcp.json
.wardnet-local/
.target-linux/
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.ds-sync/
ds-bundle/


# files and folders managed by agentic toolkit 
.claude
.mcp.json
CLAUDE.md
.agentic-toolkit.lock.yaml

# scratch screenshots used when refreshing the docs/blog images
.shots-tmp/
